From: DroidVM Gunyah SM8650 fix (ported to manet)
Subject: [PATCH] drivers: gunyah: fix SM8650 VM creation (kvcalloc + SCM VMID)

DroidVM 的 FAQ 记录 SM8650 因内核 Gunyah 内存分配问题通常无法启动虚拟机，
并给出两个上游补丁。本补丁是它们在 manet(6.1.138) 树上的移植。

实测(Redmi K70 Pro / HyperOS 3)两种失败形态，均发生在 crosvm 请求创建 VM 时：
  4 GiB 客机 -> failed to create vm / Out of memory (os error 12)
  2 GiB 客机 -> failed to initialize virtual machine / No such device (os error 19)

1) vm_mgr_mm.c: pinned page 指针数组改用 kvcalloc/kvfree。
   4 GiB 客机该数组为 8 MiB，属高阶 kmalloc，碎片化手机上必然失败；
   vmalloc 回退不需要连续物理内存。

2) gunyah_qcom.c: 修正 SCM VMID 映射。share 的 source mask 原写死 HLOS，
   而 ACL 带的是 RM 管理的 VMID；改为共用 qcom_scm_map_vmid() 并用
   gh_rm_get_vmid() 取本机真实 VMID。VMID 错配会让 RM 拒绝 mem parcel。

上游参考:
  https://github.com/Andy312432/android_kernel_samsung_sm8650_gunyah/
    commit 3d8767092fa186b77dfcbc5fd14b53ae17b04bb2 (kvcalloc)
    commit b2ffff284b1f8b6cd79c280fb746b27fb6f0cbae (VMID)

应用(工作区根目录，路径含 msm-kernel/ 前缀故 -p1):
  patch --forward -p1 < 0003-gunyah-sm8650-startup-fix.patch

生效前提: CONFIG_GUNYAH=y 且 CONFIG_GUNYAH_QCOM_PLATFORM=y
---
--- a/msm-kernel/drivers/virt/gunyah/vm_mgr_mm.c
+++ b/msm-kernel/drivers/virt/gunyah/vm_mgr_mm.c
@@ -54,9 +54,9 @@
 		account_locked_vm(ghvm->mm, mapping->npages, false);
 	}
 
-	kfree(mapping->pages);
+	kvfree(mapping->pages);
 	kfree(mapping->parcel.acl_entries);
-	kfree(mapping->parcel.mem_entries);
+	kvfree(mapping->parcel.mem_entries);
 
 	list_del(&mapping->list);
 }
@@ -148,7 +148,12 @@
 	if (ret)
 		goto free_mapping;
 
-	mapping->pages = kcalloc(mapping->npages, sizeof(*mapping->pages), GFP_KERNEL_ACCOUNT);
+	/*
+	 * Large guests can require hundreds of KiB just for the pinned-page
+	 * pointer array; use vmalloc fallback rather than high-order kmalloc.
+	 */
+	mapping->pages = kvcalloc(mapping->npages, sizeof(*mapping->pages),
+				  GFP_KERNEL_ACCOUNT);
 	if (!mapping->pages) {
 		ret = -ENOMEM;
 		mapping->npages = 0; /* update npages for reclaim */
@@ -212,9 +217,9 @@
 			parcel->n_mem_entries++;
 	}
 
-	parcel->mem_entries = kcalloc(parcel->n_mem_entries,
-					sizeof(parcel->mem_entries[0]),
-					GFP_KERNEL_ACCOUNT);
+	parcel->mem_entries = kvcalloc(parcel->n_mem_entries,
+				       sizeof(parcel->mem_entries[0]),
+				       GFP_KERNEL_ACCOUNT);
 	if (!parcel->mem_entries) {
 		ret = -ENOMEM;
 		goto free_acl;
@@ -248,7 +253,7 @@
 unpin_pages:
 	unpin_user_pages(mapping->pages, pinned);
 free_pages:
-	kfree(mapping->pages);
+	kvfree(mapping->pages);
 unlock_pages:
 	account_locked_vm(ghvm->mm, mapping->npages, false);
 free_mapping:
--- a/msm-kernel/drivers/virt/gunyah/gunyah_qcom.c
+++ b/msm-kernel/drivers/virt/gunyah/gunyah_qcom.c
@@ -14,12 +14,29 @@
 #define QCOM_SCM_RM_MANAGED_VMID	0x3A
 #define QCOM_SCM_MAX_MANAGED_VMID	0x3F
 
+/*
+ * ACL 里带的是 RM 管理的 VMID；超出 SCM 可管理范围的用 RM 哨兵值代替。
+ * 抽成 helper 让 share / reclaim 共用同一套映射，避免两处判定漂移。
+ */
+static u16 qcom_scm_map_vmid(u16 vmid)
+{
+	if (vmid <= QCOM_SCM_MAX_MANAGED_VMID)
+		return vmid;
+
+	return QCOM_SCM_RM_MANAGED_VMID;
+}
+
 static int qcom_scm_gh_rm_pre_mem_share(void *rm, struct gh_rm_mem_parcel *mem_parcel)
 {
 	struct qcom_scm_vmperm *new_perms;
 	u64 src, src_cpy;
 	int ret = 0, i, n, rb_ret;
-	u16 vmid;
+	u16 self_vmid, vmid;
+
+	/* 借出内存的 source 必须是本机(HLOS)真实 VMID，写死会被 RM 拒绝 */
+	ret = gh_rm_get_vmid(rm, &self_vmid);
+	if (ret)
+		return ret;
 
 	new_perms = kcalloc(mem_parcel->n_acl_entries, sizeof(*new_perms), GFP_KERNEL);
 	if (!new_perms)
@@ -27,10 +44,7 @@
 
 	for (n = 0; n < mem_parcel->n_acl_entries; n++) {
 		vmid = le16_to_cpu(mem_parcel->acl_entries[n].vmid);
-		if (vmid <= QCOM_SCM_MAX_MANAGED_VMID)
-			new_perms[n].vmid = vmid;
-		else
-			new_perms[n].vmid = QCOM_SCM_RM_MANAGED_VMID;
+		new_perms[n].vmid = qcom_scm_map_vmid(vmid);
 		if (mem_parcel->acl_entries[n].perms & GH_RM_ACL_X)
 			new_perms[n].perm |= QCOM_SCM_PERM_EXEC;
 		if (mem_parcel->acl_entries[n].perms & GH_RM_ACL_W)
@@ -39,7 +53,7 @@
 			new_perms[n].perm |= QCOM_SCM_PERM_READ;
 	}
 
-	src = BIT_ULL(QCOM_SCM_VMID_HLOS);
+	src = BIT_ULL(qcom_scm_map_vmid(self_vmid));
 
 	for (i = 0; i < mem_parcel->n_mem_entries; i++) {
 		src_cpy = src;
@@ -56,10 +70,7 @@
 	src = 0;
 	for (n = 0; n < mem_parcel->n_acl_entries; n++) {
 		vmid = le16_to_cpu(mem_parcel->acl_entries[n].vmid);
-		if (vmid <= QCOM_SCM_MAX_MANAGED_VMID)
-			src |= BIT_ULL(vmid);
-		else
-			src |= BIT_ULL(QCOM_SCM_RM_MANAGED_VMID);
+		src |= BIT_ULL(qcom_scm_map_vmid(vmid));
 	}
 
 	new_perms[0].vmid = QCOM_SCM_VMID_HLOS;
@@ -87,17 +98,18 @@
 	struct qcom_scm_vmperm new_perms;
 	u64 src = 0, src_cpy;
 	int ret = 0, i, n;
-	u16 vmid;
+	u16 self_vmid, vmid;
+
+	ret = gh_rm_get_vmid(rm, &self_vmid);
+	if (ret)
+		return ret;
 
 	new_perms.vmid = QCOM_SCM_VMID_HLOS;
 	new_perms.perm = QCOM_SCM_PERM_EXEC | QCOM_SCM_PERM_WRITE | QCOM_SCM_PERM_READ;
 
 	for (n = 0; n < mem_parcel->n_acl_entries; n++) {
 		vmid = le16_to_cpu(mem_parcel->acl_entries[n].vmid);
-		if (vmid <= QCOM_SCM_MAX_MANAGED_VMID)
-			src |= (1ull << vmid);
-		else
-			src |= (1ull << QCOM_SCM_RM_MANAGED_VMID);
+		src |= BIT_ULL(qcom_scm_map_vmid(vmid));
 	}
 
 	for (i = 0; i < mem_parcel->n_mem_entries; i++) {
